# Operating-system and editor files
.DS_Store
**/.DS_Store
.idea/
.vscode/

# Python environments and caches
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/

# Local plotting caches
.mplconfig/
**/.mplconfig/

# Raw IMDb/Amazon source snapshots and reconstructed canonical tables.
# The runnable benchmark subdatasets are versioned under <dataset>/data/subdatasets
# instead. These are local build products, regenerable via restore_original_data.py /
# build_local_catalog.py, and too large for version control (raw sources alone are
# ~600MB; amazon/canonical/texts.csv is ~220MB, over GitHub's 100MB push limit).
imdb/data/sources/
imdb/data/canonical/*.csv
amazon/canonical/*.csv

# Runtime logs and cluster scheduler artifacts
*.log
*.err
*.out
OAR.*
**/logs/
**/aker_logs/
**/monitoring/
**/jobs/

# Benchmark runs keep only summary tables and plots in version control
imdb/benchmarks/*/outputs/**
amazon/benchmarks/*/outputs/**
!*/benchmarks/*/outputs/*/
!*/benchmarks/*/outputs/*/aggregate.csv
!*/benchmarks/*/outputs/*/comparison.csv
!*/benchmarks/*/outputs/*/plots/
!*/benchmarks/*/outputs/*/plots/*.png
!*/benchmarks/*/outputs/*/paper_plots/
!*/benchmarks/*/outputs/*/paper_plots/*.png
!*/benchmarks/*/outputs/*/per_question/
!*/benchmarks/*/outputs/*/per_question/*/
!*/benchmarks/*/outputs/*/per_question/*/plots/
!*/benchmarks/*/outputs/*/per_question/*/plots/*.png
!*/benchmarks/*/outputs/*/q_*/
!*/benchmarks/*/outputs/*/q_*/plots/
!*/benchmarks/*/outputs/*/q_*/plots/*.png

# Local model/server state
.ollama/

# Generated LaTeX files
*.aux
*.fdb_latexmk
*.fls
*.nav
*.out
*.snm
*.synctex.gz
*.toc

# Third-party reading material is kept locally
docs/papers/

# Nested repository metadata backup, if present
.git.nested-backup/
**/.git.nested-backup/
